@page
@model GeekOAuth.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-card">
    <h1 class="auth-title">Reset password</h1>
    @if (Model.ResetComplete)
    {
        <p class="auth-hint">Your password was updated.</p>
        <a class="auth-button" href="/Account/Login">Sign in</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }
        <form method="post">
            <input type="hidden" asp-for="Input.Email" />
            <input type="hidden" asp-for="Input.Code" />
            <div class="auth-field">
                <label asp-for="Input.Password">New password</label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" />
            </div>
            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
            </div>
            <button type="submit" class="auth-button">Update password</button>
        </form>
    }
</div>
