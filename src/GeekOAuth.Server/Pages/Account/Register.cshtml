@page
@model GeekOAuth.Pages.Account.RegisterModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-card">
    <h1 class="auth-title">Create account</h1>

    @if (Model.RegistrationSent)
    {
        @if (Model.AutoConfirmed)
        {
            <p class="auth-hint" role="status">Your account was created. You can sign in now.</p>
        }
        else
        {
            <p class="auth-hint" role="status">Check your email for a confirmation link.@(Env.IsDevelopment() ? " In Development, the link is also written to the server console." : "")</p>
        }
        <p><a href="@Url.Page("/Account/Login", new { returnUrl = Model.ReturnUrl })">@(Model.ReturnUrl is null ? "Back to sign in" : "Continue to sign in")</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" aria-describedby="email-validation" autofocus />
                <span asp-validation-for="Input.Email" id="email-validation" class="auth-validation"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" aria-describedby="password-validation" />
                <span asp-validation-for="Input.Password" id="password-validation" class="auth-validation"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" aria-describedby="confirm-password-validation" />
                <span asp-validation-for="Input.ConfirmPassword" id="confirm-password-validation" class="auth-validation"></span>
            </div>
            <button type="submit" class="auth-button">Create account</button>
        </form>
        <p class="auth-footer"><a href="@Url.Page("/Account/Login", new { returnUrl = Model.ReturnUrl })">Already have an account?</a></p>
    }
</div>
