@page
@model GeekOAuth.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card">
    <h1 class="auth-title">Forgot password</h1>
    @if (Model.EmailSent)
    {
        <p class="auth-hint">If that email exists, a reset link was sent. In Development, check the server console.</p>
        <p><a href="/Account/Login">Back to sign in</a></p>
    }
    else
    {
        <form method="post">
            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" autofocus />
            </div>
            <button type="submit" class="auth-button">Send reset link</button>
        </form>
        <p class="auth-footer"><a href="/Account/Login">Back to sign in</a></p>
    }
</div>
