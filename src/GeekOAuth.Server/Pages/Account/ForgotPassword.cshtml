@page
@model GeekOAuth.Pages.Account.ForgotPasswordModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card">
    <h1 class="auth-title">Forgot password</h1>
    @if (Model.EmailSent)
    {
        <p class="auth-hint" role="status">If that email exists, a reset link was sent.@(Env.IsDevelopment() ? " In Development, check the server console." : "")</p>
        <p><a href="/Account/Login">Back to sign in</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error" role="alert">@Model.ErrorMessage</div>
        }
        <form method="post">
            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" aria-describedby="email-validation" autofocus />
                <span asp-validation-for="Input.Email" id="email-validation" class="auth-validation"></span>
            </div>
            <button type="submit" class="auth-button">Send reset link</button>
        </form>
        <p class="auth-footer"><a href="/Account/Login">Back to sign in</a></p>
    }
</div>
