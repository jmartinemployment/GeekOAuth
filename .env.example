# Copy to Railway variables or local shell export. Never commit real secrets.

DATABASE_URL=Host=localhost;Port=5432;Database=geek_oauth;Username=postgres;Password=postgres
ISSUER_URL=https://auth.yourdomain.com
DATA_PROTECTION_PURPOSE=GeekOAuth-production

# Base64-encoded PFX (required in production)
SIGNING_CERT_BASE64=
SIGNING_CERT_PASSWORD=
ENCRYPTION_CERT_BASE64=
ENCRYPTION_CERT_PASSWORD=

# OAuth client secrets (min 32 chars)
CLIENT_SECRET_GEEKAPI=
CLIENT_SECRET_GEEKWEBSITE=

# Comma-separated SPA origins allowed to call the token endpoint with CORS
CORS_ORIGINS=https://app.yourdomain.com

# OAuth redirect_uri origins allowed in Chrome's post-login redirect chain (form-action CSP).
# Defaults to CORS_ORIGINS when unset. Must include every registered client redirect origin,
# e.g. https://seo.geekatyourspot.com for Geek SEO web.
# FORM_ACTION_ORIGINS=https://seo.geekatyourspot.com,http://localhost:3000

# Optional SMTP (dev logs links to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
