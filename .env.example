# Copy to Railway variables or local shell export. Never commit real secrets.

# Supabase PostgreSQL (shared with GeekRepository, schema: content-writer-3)
# Note: GeekOAuth is the exception to the rule that all services go through GeekRepository
# Due to circular dependency (GeekOAuth must exist to issue tokens for GeekRepository access),
# GeekOAuth connects directly to Supabase
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres?schema=content-writer-3&sslmode=require

ISSUER_URL=https://auth.geekatyourspot.com
DATA_PROTECTION_PURPOSE=GeekOAuth-production

# Base64-encoded PFX (required in production)
SIGNING_CERT_BASE64=
SIGNING_CERT_PASSWORD=
ENCRYPTION_CERT_BASE64=
ENCRYPTION_CERT_PASSWORD=

# OAuth client secrets (min 32 chars)
CLIENT_SECRET_GEEKAPI=
CLIENT_SECRET_GEEKWEBSITE=

# Comma-separated SPA origins allowed to call the token endpoint with CORS
CORS_ORIGINS=https://content-writer.geekatyourspot.com,https://content-writer-v3.vercel.app,https://seo.geekatyourspot.com,http://localhost:3000

# OAuth redirect_uri origins allowed in Chrome's post-login redirect chain (form-action CSP).
# Must include every registered client redirect origin
FORM_ACTION_ORIGINS=https://content-writer.geekatyourspot.com,https://content-writer-v3.vercel.app,https://seo.geekatyourspot.com,http://localhost:3000

# Optional SMTP (dev logs links to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@geekatyourspot.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
